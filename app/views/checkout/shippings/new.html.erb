<h1>Shipping Information</h1>

<% if flash[:alert].present? %>
  <p style="color: red; margin-bottom: 10px;"><%= flash[:alert] %></p>
<% end %>

<% if defined?(@errors) && @errors.present? %>
  <div style="border: 1px solid red; padding: 10px; margin-bottom: 15px; color: red;">
    <h4>There were problems with your shipping details:</h4>
    <ul>
      <% @errors.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with url: "/checkout/shipping", scope: :shipping, local: true do |f| %>
  <div class="mb-3">
    <%= f.label :shipping_name, "Name" %><br>
    <%= f.text_field :shipping_name,
                     class: "form-control",
                     required: true,
                     value: @shipping&.shipping_name %>
  </div>

  <div class="mb-3">
    <%= f.label :shipping_address, "Address" %><br>
    <%= f.text_field :shipping_address,
                     class: "form-control",
                     required: true,
                     value: @shipping&.shipping_address %>
  </div>

  <div class="mb-3">
    <%= f.label :shipping_city, "City" %><br>
    <%= f.text_field :shipping_city,
                     class: "form-control",
                     required: true,
                     value: @shipping&.shipping_city %>
  </div>

  <div class="mb-3">
    <%= f.label :shipping_state, "State" %><br>
    <%= f.text_field :shipping_state,
                     class: "form-control",
                     required: true,
                     value: @shipping&.shipping_state %>
  </div>

  <div class="mb-3">
    <%= f.label :shipping_zip, "ZIP" %><br>
    <%= f.text_field :shipping_zip,
                     class: "form-control",
                     required: true,
                     value: @shipping&.shipping_zip %>
  </div>

  <div class="mb-3">
    <%= f.label :shipping_phone, "Phone" %><br>
    <%= f.telephone_field :shipping_phone,
                          class: "form-control",
                          required: true,
                          value: @shipping&.shipping_phone %>
  </div>

  <%= f.submit "Continue to Payment", class: "btn btn-primary" %>
<% end %>
