<h1>Write a Review for <%= @corpse_flower.name %></h1>

<% if flash[:alert].present? %>
  <p style="color: red;"><%= flash[:alert] %></p>
<% end %>

<% if @review.errors.any? %>
  <div style="color: red;">
    <h4>There were some problems with your review:</h4>
    <ul>
      <% @review.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: [@corpse_flower, @review], local: true, html: { multipart: true, id: "review-form" } do |f| %>
  <div class="mb-3">
    <%= f.label :rating, "Rating" %><br>

    <%= f.hidden_field :rating, id: "review_rating" %>

    <div id="star-rating" style="font-size: 2rem; cursor: pointer;">
      <% 1.upto(5) do |star| %>
        <span
          class="star"
          data-value="<%= star %>"
          style="display: inline-block; padding: 0 4px;"
        >
          ★
        </span>
      <% end %>
    </div>

    <small class="form-text text-muted">
      Click a star to set your rating.
    </small>
  </div>

  <div class="mb-3">
    <%= f.label :title, "Title" %>
    <%= f.text_field :title, class: "form-control", required: true %>
  </div>

  <div class="mb-3">
    <%= f.label :comment, "Review" %>
    <%= f.text_area :comment, class: "form-control", rows: 5, required: true %>
  </div>

  <div class="mb-3">
    <%= f.label :image, "Photo (optional)" %><br>
    <%= f.file_field :image, accept: "image/*" %>
    <small class="form-text text-muted">
      Upload an image from your device.
    </small>
  </div>

  <%= f.submit "Submit Review", class: "btn btn-primary" %>
  <%= link_to "Cancel", @corpse_flower, class: "btn btn-secondary ms-2" %>
<% end %>

<style>
  #star-rating .star {
    color: #ccc; /* default grey before hover/click */
    transition: color 0.2s ease;
  }
</style>

<script>
  function initReviewStars() {
    const starsContainer = document.getElementById("star-rating");
    const ratingInput = document.getElementById("review_rating");
    if (!starsContainer || !ratingInput) return;

    const stars = starsContainer.querySelectorAll(".star");
    let currentRating = parseInt(ratingInput.value || "0", 10);

    function renderStars(hoverValue = 0) {
      const activeValue = hoverValue || currentRating;
      stars.forEach((star) => {
        const value = parseInt(star.dataset.value, 10);
        star.style.color = value <= activeValue ? "#f5c518" : "#ccc";
      });
    }

    stars.forEach((star) => {
      star.addEventListener("mouseenter", () => {
        const hoverValue = parseInt(star.dataset.value, 10);
        renderStars(hoverValue);
      });

      star.addEventListener("mouseleave", () => {
        renderStars();
      });

      star.addEventListener("click", () => {
        currentRating = parseInt(star.dataset.value, 10);
        ratingInput.value = currentRating;
        renderStars();
      });
    });

    renderStars();
  }

  document.addEventListener("DOMContentLoaded", initReviewStars);
  document.addEventListener("turbo:load", initReviewStars);
</script>
