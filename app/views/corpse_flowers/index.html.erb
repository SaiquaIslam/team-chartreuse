<div class="browse-page mt-4">
  <div class="row">
    
    <!-- ============================= -->
    <!-- SIDEBAR FILTERS (M2 PR1 - US04) -->
    <!-- ============================= -->
    <div class="col-md-3">
      <div class="filters-sidebar">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="mb-0">Filters</h5>
          <% if filters_active? %>
            <%= link_to "Clear All", corpse_flowers_path(search: params[:search], sort: params[:sort]), class: "btn btn-sm btn-outline-danger" %>
          <% end %>
        </div>

        <%= form_with(url: corpse_flowers_path, method: :get, local: true) do |f| %>
          
          <!-- Preserve search and sort parameters -->
          <%= hidden_field_tag :search, params[:search] if params[:search].present? %>
          <%= hidden_field_tag :sort, params[:sort] if params[:sort].present? %>

          <!-- SIZE FILTER -->
          <div class="filter-section">
            <h6>Size</h6>
            <% @available_sizes.each do |size| %>
              <div class="form-check">
                <%= check_box_tag 'sizes[]', size, 
                    (params[:sizes] || []).include?(size), 
                    class: 'form-check-input', 
                    id: "size_#{size}",
                    onchange: 'this.form.submit()' %>
                <%= label_tag "size_#{size}", size.capitalize, class: 'form-check-label' %>
              </div>
            <% end %>
          </div>

          <!-- COLOR FILTER -->
          <div class="filter-section">
            <h6>Color</h6>
            <% if @available_colors.any? %>
              <% @available_colors.each do |color| %>
                <div class="form-check">
                  <%= check_box_tag 'colors[]', color, 
                      (params[:colors] || []).include?(color), 
                      class: 'form-check-input', 
                      id: "color_#{color}",
                      onchange: 'this.form.submit()' %>
                  <%= label_tag "color_#{color}", color.capitalize, class: 'form-check-label' %>
                </div>
              <% end %>
            <% else %>
              <p class="text-muted small">No colors available</p>
            <% end %>
          </div>

          <!-- PUTRIDITY FILTER -->
          <div class="filter-section">
            <h6>Putridity Level</h6>
            <% @putridity_ranges.each do |range| %>
              <div class="form-check">
                <%= check_box_tag 'putridity_ranges[]', range[:value], 
                    (params[:putridity_ranges] || []).include?(range[:value]), 
                    class: 'form-check-input', 
                    id: "putridity_#{range[:value]}",
                    onchange: 'this.form.submit()' %>
                <%= label_tag "putridity_#{range[:value]}", range[:label], class: 'form-check-label' %>
              </div>
            <% end %>
          </div>

        <% end %>
      </div>
    </div>

    <!-- ============================= -->
    <!-- FLOWERS LIST -->
    <!-- ============================= -->
    <div class="col-md-9">

      <!-- SORT DROPDOWN (M2 PR2 - US05) -->
      <div class="d-flex justify-content-end align-items-center mb-3">
        <%= form_with(url: corpse_flowers_path, method: :get, local: true, class: "d-flex align-items-center") do |f| %>
          
          <!-- Preserve search and filter parameters -->
          <%= hidden_field_tag :search, params[:search] if params[:search].present? %>
          <% if params[:sizes].present? %>
            <% params[:sizes].each do |size| %>
              <%= hidden_field_tag 'sizes[]', size %>
            <% end %>
          <% end %>
          <% if params[:colors].present? %>
            <% params[:colors].each do |color| %>
              <%= hidden_field_tag 'colors[]', color %>
            <% end %>
          <% end %>
          <% if params[:putridity_ranges].present? %>
            <% params[:putridity_ranges].each do |range| %>
              <%= hidden_field_tag 'putridity_ranges[]', range %>
            <% end %>
          <% end %>

          <label class="me-2 mb-0">Sort by</label>
          <%= select_tag :sort, 
              options_for_select(@sort_options.map { |opt| [opt[:label], opt[:value]] }, @current_sort),
              class: "form-select",
              style: "width: auto;",
              onchange: "this.form.submit()" %>
        <% end %>
      </div>

      <!-- ACTIVE FILTERS DISPLAY -->
      <% if filters_active? %>
        <div class="alert alert-info mb-3">
          <strong>Active Filters:</strong>
          <% if params[:sizes].present? %>
            <span class="badge bg-primary me-1">Size: <%= params[:sizes].join(', ').capitalize %></span>
          <% end %>
          <% if params[:colors].present? %>
            <span class="badge bg-success me-1">Color: <%= params[:colors].join(', ').capitalize %></span>
          <% end %>
          <% if params[:putridity_ranges].present? %>
            <span class="badge bg-warning me-1">
              Putridity: <%= params[:putridity_ranges].map { |r| r.gsub('-', ' to ') }.join(', ') %>
            </span>
          <% end %>
          <%= link_to 'Clear All', corpse_flowers_path(search: params[:search], sort: params[:sort]), class: 'btn btn-sm btn-outline-secondary ms-2' %>
        </div>
      <% end %>

      <!-- IF SEARCH RETURNS NO RESULTS -->
      <% if params[:search].present? && @corpse_flowers.empty? %>
        <div class="text-center py-5">
          <h4 class="text-muted">No flowers found for "<%= params[:search] %>"</h4>
          <p class="text-muted mb-3">Try searching for different keywords</p>
          <%= link_to 'Clear search', corpse_flowers_path(sort: params[:sort]), class: 'btn btn-outline-secondary' %>
        </div>

      <!-- IF FILTERS RETURN NO RESULTS -->
      <% elsif filters_active? && @corpse_flowers.empty? %>
        <div class="text-center py-5">
          <h4 class="text-muted">No flowers match your filters</h4>
          <p class="text-muted mb-3">Try adjusting your filter selections</p>
          <%= link_to 'Clear filters', corpse_flowers_path(search: params[:search], sort: params[:sort]), class: 'btn btn-outline-secondary' %>
        </div>

      <% elsif @corpse_flowers.any? %>

        <!-- SEARCH RESULT COUNT -->
        <% if params[:search].present? %>
          <div class="alert alert-secondary mb-3">
            Found <%= pluralize(@corpse_flowers.count, "flower") %> matching
            "<strong><%= params[:search] %></strong>"
            <%= link_to 'Clear', corpse_flowers_path(sort: params[:sort]), class: 'btn btn-sm btn-outline-secondary ms-2' %>
          </div>
        <% end %>

        <!-- FILTER RESULT COUNT -->
        <% if filters_active? && params[:search].blank? %>
          <p class="text-muted mb-3">
            Showing <%= pluralize(@corpse_flowers.count, "flower") %>
          </p>
        <% end %>

        <!-- ============================= -->
        <!-- FLOWER CARDS GRID -->
        <!-- ============================= -->
        <div class="row row-cols-1 row-cols-lg-2 g-4">

          <% @corpse_flowers.each do |flower| %>
            <div class="col">
              <div class="card flower-card">

                <%= link_to corpse_flower_path(flower) do %>

                  <% if flower.images.attached? %>
                    <%= image_tag(
                        url_for(flower.images.first),
                        alt: flower.name,
                        style: "width:100%; height:200px; object-fit:cover;"
                      ) %>
                  <% elsif flower.image_url.present? %>
                    <%= image_tag(
                        flower.image_url,
                        alt: flower.name,
                        style: "width:100%; height:200px; object-fit:cover;"
                      ) %>
                  <% end %>

                <% end %>

                <div class="card-body">
                  <%= link_to flower.name,
                      corpse_flower_path(flower),
                      class: "flower-name d-block mb-2" %>

                  <p class="flower-attributes mb-2">
                    <%= flower.size.capitalize %> – Putridity: <%= flower.putridity %> – <%= flower.color.capitalize %>
                  </p>

                  <h5 class="flower-price">
                    <%= flower.display_price rescue "$#{flower.price}" %>
                  </h5>
                </div>

              </div>
            </div>
          <% end %>

        </div>

      <% else %>

        <!-- IF NO FLOWERS IN DATABASE -->
        <div class="text-center py-5">
          <h4 class="text-muted">No flowers available</h4>
        </div>

      <% end %>

    </div>
  </div>
</div>