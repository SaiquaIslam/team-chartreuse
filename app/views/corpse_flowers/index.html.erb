<div class="browse-page mt-4">
  <div class="row">
    
    <!-- ============================= -->
    <!-- SIDEBAR FILTERS (STATIC IN M1) -->
    <!-- ============================= -->
    <div class="col-md-3">
      <div class="filters-sidebar">
        <h5>Filters</h5>

        <div class="filter-section">
          <h6>Size</h6>
          <div class="form-check"><input class="form-check-input" type="checkbox" disabled><label class="form-check-label">Small (2–4ft)</label></div>
          <div class="form-check"><input class="form-check-input" type="checkbox" disabled><label class="form-check-label">Medium (5–7ft)</label></div>
          <div class="form-check"><input class="form-check-input" type="checkbox" disabled><label class="form-check-label">Large (8–10ft)</label></div>
        </div>

        <div class="filter-section">
          <h6>Putridity</h6>
          <div class="form-check"><input class="form-check-input" type="checkbox" disabled><label class="form-check-label">Mild</label></div>
          <div class="form-check"><input class="form-check-input" type="checkbox" disabled><label class="form-check-label">Moderate</label></div>
          <div class="form-check"><input class="form-check-input" type="checkbox" disabled><label class="form-check-label">Strong</label></div>
        </div>

        <div class="filter-section">
          <h6>Color</h6>
          <div class="form-check"><input class="form-check-input" type="checkbox" disabled><label class="form-check-label">Light</label></div>
          <div class="form-check"><input class="form-check-input" type="checkbox" disabled><label class="form-check-label">Medium</label></div>
          <div class="form-check"><input class="form-check-input" type="checkbox" disabled><label class="form-check-label">Dark</label></div>
        </div>

        <small class="text-muted d-block mt-3"><em>Filters coming in M2</em></small>
      </div>
    </div>

    <!-- ============================= -->
    <!-- FLOWERS LIST -->
    <!-- ============================= -->
    <div class="col-md-9">

      <div class="d-flex justify-content-end align-items-center mb-3">
        <label class="me-2 mb-0">Sort by</label>
        <select class="form-select" style="width: auto;" disabled>
          <option>Price: Low to High</option>
        </select>
      </div>

      <!-- IF SEARCH RETURNS NO RESULTS -->
      <% if params[:search].present? && @corpse_flowers.empty? %>
        <div class="text-center py-5">
          <h4 class="text-muted">No flowers found for "<%= params[:search] %>"</h4>
          <p class="text-muted mb-3">Try searching for different keywords</p>
          <%= link_to 'Clear search', corpse_flowers_path, class: 'btn btn-outline-secondary' %>
        </div>

      <% elsif @corpse_flowers.any? %>

        <!-- SEARCH RESULT COUNT -->
        <% if params[:search].present? %>
          <div class="alert alert-info mb-3">
            Found <%= pluralize(@corpse_flowers.count, "flower") %> matching
            "<strong><%= params[:search] %></strong>"
            <%= link_to 'Clear', corpse_flowers_path, class: 'btn btn-sm btn-outline-secondary ms-2' %>
          </div>
        <% end %>

        <!-- ============================= -->
        <!-- FLOWER CARDS GRID -->
        <!-- ============================= -->
        <div class="row row-cols-1 row-cols-lg-2 g-4">

          <% @corpse_flowers.each do |flower| %>
            <div class="col">
              <div class="card flower-card">

                <%= link_to corpse_flower_path(flower) do %>

                  <%# ---------------------------------------------- %>
                  <%# IMAGE PRIORITY (NO PLACEHOLDER)                %>
                  <%# 1. ActiveStorage images                        %>
                  <%# 2. Seed image_url                              %>
                  <%# 3. Nothing else                                %>
                  <%# ---------------------------------------------- %>

                  <% if flower.images.attached? %>

                    <%= image_tag(
                        url_for(flower.images.first),
                        alt: flower.name,
                        style: "width:100%; height:200px; object-fit:cover;"
                      ) %>

                  <% elsif flower.image_url.present? %>

                    <%= image_tag(
                        flower.image_url,
                        alt: flower.name,
                        style: "width:100%; height:200px; object-fit:cover;"
                      ) %>

                  <% end %>

                <% end %>

                <div class="card-body">
                  <%= link_to flower.name,
                      corpse_flower_path(flower),
                      class: "flower-name d-block mb-2" %>

                  <p class="flower-attributes mb-2">
                    <%= flower.size %> – <%= flower.putridity %>
                  </p>

                  <h5 class="flower-price">
                    <%= flower.display_price rescue "$#{flower.price}" %>
                  </h5>
                </div>

              </div>
            </div>
          <% end %>

        </div>

      <% else %>

        <!-- IF NO FLOWERS IN DATABASE -->
        <div class="text-center py-5">
          <h4 class="text-muted">No flowers available</h4>
        </div>

      <% end %>

    </div>
  </div>
</div>
