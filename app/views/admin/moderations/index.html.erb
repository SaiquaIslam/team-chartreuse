<div class="container mt-4">
  <h1 class="fw-bold mb-4">Moderate Content</h1>

  <ul class="nav nav-tabs mb-4">
    <li class="nav-item">
      <a class="nav-link active" data-bs-toggle="tab" href="#reviews">Reviews</a>
    </li>
  </ul>

  <div class="tab-content">
    <div class="tab-pane fade show active" id="reviews">
      <h4>Flagged Reviews</h4>

      <% if @flagged_reviews.empty? %>
        <p class="text-muted">No flagged reviews found.</p>
      <% else %>
        <table class="table table-bordered table-hover">
          <thead class="table-light">
            <tr>
              <th>User</th>
              <th>Flower</th>
              <th>Rating</th>
              <th>Comment</th>
              <th>Actions</th>
            </tr>
          </thead>

          <tbody>
            <% @flagged_reviews.each do |review| %>
              <tr>
                <td><%= review.user.email %></td>
                <td><%= review.corpse_flower.name %></td>
                <td><%= review.rating %></td>
                <td><%= review.comment %></td>

                <td>
                  <%= link_to "Delete",
                      admin_moderation_path(review),
                      data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                      class: "btn btn-sm btn-danger" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>
  </div>
</div>
