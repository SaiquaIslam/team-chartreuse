<h1 class="my-4">Scavenger Hunt – Registered Flowers</h1>

<div class="container my-4">
  <div class="card shadow-sm border-0">
    <div class="card-body">
      <%= form_with url: hunt_path, method: :get, local: true, class: "row gy-2 align-items-center" do %>

        <div class="col-md-8">
          <%= text_field_tag :query, params[:query],
                class: "form-control form-control-lg rounded-pill px-4",
                placeholder: "🔍 Search flowers by nickname, location, or owner..." %>
        </div>

        <div class="col-md-2 text-md-end text-center">
          <%= submit_tag "Search",
                class: "btn btn-success btn-lg rounded-pill w-100" %>
        </div>

        <% if params[:query].present? %>
          <div class="col-md-2 text-md-start text-center">
            <%= link_to "Clear",
                  hunt_path,
                  class: "btn btn-outline-secondary btn-lg rounded-pill w-100" %>
          </div>
        <% end %>

      <% end %>
    </div>
  </div>
</div>



<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">
    <thead>
      <tr>
        <th>Photo</th>
        <th>Flower Nickname</th>
        <th>Location</th>
        <th>Owner</th>
        <th>Action</th>
      </tr>
    </thead>

    <tbody>
      <% @hunt_registrations.each do |hunt| %>
        <tr>

          <!-- 🌸 Photo column -->
<td>
  <% if hunt.photo.attached? %>
    <%= image_tag hunt.photo,
                  alt: "Flower photo",
                  class: "rounded border",
                  style: "width: 80px; height: 80px; object-fit: cover;" %>
  <% else %>
    <span class="text-muted">(No photo)</span>
  <% end %>
</td>


          <!-- 🌱 Nickname -->
          <td><strong><%= hunt.nickname.presence || "(No nickname)" %></strong></td>

          <!-- 📍 Location -->
          <td><%= hunt.location_description.presence || "(No location)" %></td>

          <!-- 👤 Owner -->
          <td>
            <% if hunt.user.present? %>
              <%= hunt.user.email %>
            <% else %>
              (Unknown)
            <% end %>
          </td>
                    <td class="text-nowrap">
            <%= link_to 'View Details', hunt_registration_show_path(hunt),
                        class: 'btn btn-success btn-sm' %>
          </td>

          <% if current_user == hunt.user %>
            </td>
                    <td class="text-nowrap">
              <%= link_to 'Update Hunt', edit_hunt_registration_path(hunt),
                          class: 'btn btn-success btn-sm' %>
            </td>
            </td>
                    <td class="text-nowrap">
              <%= link_to 'Remove from Hunt', confirm_remove_hunt_registration_path(hunt),
                          class: 'btn btn-danger me-3' %>
            </td>

          <% end %>

                      </td>
                    <td class="text-nowrap">
              <%= link_to "Record My Visit", new_hunt_registration_visit_path(hunt), class: "btn btn-sm btn-primary" if user_signed_in? %>
            </td>
        
        </tr>
      <% end %>
    </tbody>
  </table>
</div>


<p>
  <%= link_to 'Back', root_path, class: 'btn btn-outline-primary' %>
</p>

