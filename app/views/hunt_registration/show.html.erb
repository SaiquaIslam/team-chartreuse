<h1 class="my-4">
  <%= @hunt_registration.nickname.presence || "Hunt Flower Details" %>
</h1>

<div class="row mb-4">
  <!-- LEFT: Photo -->
  <div class="col-md-5 mb-3">
    <% if @hunt_registration.photo.attached? %>
      <%= image_tag @hunt_registration.photo,
                    alt: "Flower photo",
                    class: "img-fluid rounded border",
                    style: "max-height: 320px; object-fit: cover; width: 100%;" %>
    <% else %>
      <div class="d-flex align-items-center justify-content-center bg-light border rounded"
           style="height: 240px;">
        <span class="text-muted">No photo uploaded yet.</span>
      </div>
    <% end %>
  </div>

  <!-- RIGHT: Flower & Owner only -->
  <div class="col-md-7">
    <div class="card mb-3">
      <div class="card-body">
        <h5 class="card-title mb-3">Flower & Owner</h5>

        <% if @corpse_flower.present? %>
          <p><strong>Flower:</strong> <%= @corpse_flower.name %></p>
          <p><strong>Putridity:</strong> <%= @corpse_flower.putridity %></p>
          <p><strong>Color:</strong> <%= @corpse_flower.color %></p>
          <p><strong>Size:</strong> <%= @corpse_flower.size %></p>
        <% else %>
          <p class="text-muted mb-3">Flower specs are not linked yet.</p>
        <% end %>

        <p><strong>Nickname:</strong> <%= @hunt_registration.nickname.presence || "(No nickname)" %></p>
        <p><strong>Owner:</strong>
          <%= @hunt_registration.user&.email || "(Unknown owner)" %>
        </p>
      </div>
    </div>
  </div>
</div> <!-- END ROW -->


<!-- NOW BELOW BOTH COLUMNS -->


<!-- Location block -->
<div class="card mb-4">
  <div class="card-body">
    <h5 class="card-title mb-3">Location</h5>

    <p><strong>Address or Place:</strong><br>
      <%= @hunt_registration.location_description.presence || "(No location provided)" %>
    </p>

    <% if @hunt_registration.latitude.present? && @hunt_registration.longitude.present? %>
      <p><strong>Coordinates:</strong>
        <%= @hunt_registration.latitude %>, <%= @hunt_registration.longitude %>
      </p>
    <% end %>
  </div>
</div>


<!-- Visiting instructions -->
<div class="card mb-4">
  <div class="card-body">
    <h5 class="card-title mb-3">Visiting Instructions</h5>
    <%= simple_format(@hunt_registration.instructions.presence ||
          "No visiting instructions have been provided yet.") %>
  </div>
</div>


<!-- Visit Gallery -->
<div class="card mb-4">
  <div class="card-body">
    <h5 class="card-title mb-3">Visit Gallery</h5>

    <% if @visits.present? %>
      <div class="row">
        <% @visits.each do |visit| %>
          <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
              
              <% if visit.photo.attached? %>
                <%= image_tag visit.photo,
                              alt: "Visit photo",
                              class: "img-fluid rounded-top",
                              style: "height: 160px; object-fit: cover;" %>
              <% else %>
                <div class="d-flex align-items-center justify-content-center bg-light"
                     style="height: 160px;">
                  <span class="text-muted">No Photo</span>
                </div>
              <% end %>

              <div class="card-body p-2">
                <small class="text-muted">
                  Visited by: <%= visit.user.email %><br>
                  <%= time_ago_in_words(visit.created_at) %> ago
                  
                </small>

                <p class="mt-2 mb-0">Visited on :<%= visit.visited_on %></p>

                <% if visit.comment.present? %>
                  <p class="mt-2 mb-0"><%= visit.comment %></p>
                <% end %>
              </div>

            </div>
          </div>
        <% end %>
      </div>

    <% else %>
      <p class="text-muted mb-0">
        No visits recorded yet — be the first!
      </p>
    <% end %>
  </div>
</div>



<p>
  <%= link_to "Back to Hunt List", hunt_path, class: "btn btn-outline-secondary" %>
</p>
