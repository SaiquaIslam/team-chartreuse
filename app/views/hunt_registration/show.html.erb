<h1 class="my-4">
  <%= @hunt_registration.nickname.presence || "Hunt Flower Details" %>
</h1>

<div class="row mb-4">
  <!-- LEFT: Photo -->
  <div class="col-md-5 mb-3">
    <% if @hunt_registration.photo.attached? %>
      <%= image_tag @hunt_registration.photo,
                    alt: "Flower photo",
                    class: "img-fluid rounded border",
                    style: "max-height: 320px; object-fit: cover; width: 100%;" %>
    <% else %>
      <div class="d-flex align-items-center justify-content-center bg-light border rounded"
           style="height: 240px;">
        <span class="text-muted">No photo uploaded yet.</span>
      </div>
    <% end %>
  </div>

  <!-- RIGHT: Flower specs / owner / order -->
  <div class="col-md-7">
    <!-- Owner -->
    <div class="card mb-3">
      <div class="card-body">
        <h5 class="card-title mb-3">Flower & Owner</h5>

        <% if @corpse_flower.present? %>
          <p class="mb-1">
            <strong>Flower:</strong>
            <%= @corpse_flower.name %>
          </p>
          <p class="mb-1">
            <strong>Putridity:</strong>
            <%= @corpse_flower.putridity %>
          </p>
          <p class="mb-1">
            <strong>Color:</strong>
            <%= @corpse_flower.color %>
          </p>
          <p class="mb-3">
            <strong>Size:</strong>
            <%= @corpse_flower.size %>
          </p>
        <% else %>
          <p class="text-muted mb-3">
            Flower specs (size, putridity, etc.) are not linked to a purchase
            for this registration yet.
          </p>
        <% end %>

        <p class="mb-1">
          <strong>Nickname:</strong>
          <%= @hunt_registration.nickname.presence || "(No nickname)" %>
        </p>

        <p class="mb-0">
          <strong>Owner:</strong>
          <% if @hunt_registration.user.present? %>
            <%= @hunt_registration.user.email %>
          <% else %>
            (Unknown owner)
          <% end %>
        </p>
      </div>
    </div>

 
<!-- Location block -->
<div class="card mb-4">
  <div class="card-body">
    <h5 class="card-title mb-3">Location</h5>

    <p class="mb-1">
      <strong>Address or Place:</strong><br>
      <%= @hunt_registration.location_description.presence || "(No location provided)" %>
    </p>

    <% if @hunt_registration.latitude.present? && @hunt_registration.longitude.present? %>
      <p class="mb-0">
        <strong>Coordinates:</strong>
        <%= @hunt_registration.latitude %>,
        <%= @hunt_registration.longitude %>
      </p>
    <% end %>
  </div>
</div>

<!-- Visiting instructions -->
<div class="card mb-4">
  <div class="card-body">
    <h5 class="card-title mb-3">Visiting Instructions</h5>

    <% if @hunt_registration.instructions.present? %>
      <p class="mb-0">
        <%= simple_format(@hunt_registration.instructions) %>
      </p>
    <% else %>
      <p class="text-muted mb-0">
        No visiting instructions have been provided yet.
      </p>
    <% end %>
  </div>
</div>

<!-- Placeholder for visit gallery -->
<div class="card mb-4">
  <div class="card-body">
    <h5 class="card-title mb-3">Visit Gallery (Coming Soon)</h5>
    <p class="text-muted mb-0">
      This area will be implemented in M2 for visit photos and comments.
    </p>
  </div>
</div>

<p>
  <%= link_to "Back to Hunt List", hunt_path, class: "btn btn-outline-secondary" %>
</p>
