<h1 class="my-4 text-danger">Leave the Stinky Scavenger Hunt?</h1>

<div class="card mb-4">
  <div class="card-body">

    <p class="fs-5">
      You are about to remove
      <strong><%= @hunt_registration.nickname.presence || "this flower" %></strong>
      from the scavenger hunt.
    </p>

    <% if @hunt_registration.location_description.present? %>
      <p class="text-muted mb-0">
        Location:
        <%= @hunt_registration.location_description %>
      </p>
    <% end %>

  </div>
</div>

<p class="text-warning">
  ⚠ Removing this will delete its hunt visibility for other users.
</p>

<%= form_with url: hunt_registration_path(@hunt_registration),
              method: :delete,
              data: { turbo: false },
              local: true do |f| %>

  <%= f.submit "Yes, remove this flower",
               class: "btn btn-danger me-3" %>

  <%= link_to "Cancel",
              hunt_registration_path(@hunt_registration),
              class: "btn btn-outline-secondary" %>
<% end %>
