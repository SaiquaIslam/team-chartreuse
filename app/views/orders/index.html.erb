<div class="container my-5">
  <h1 class="mb-4">My Orders</h1>

  <% if flash[:alert].present? %>
    <div class="alert alert-danger">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <% if @orders.any? %>
    <% @orders.each do |order| %>
      <div class="card mb-4 shadow-sm border-0">
        <div class="card-body">
          <!-- Header row: basic order info -->
          <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
              <h5 class="card-title mb-1">
                Order #<%= order.id %>
              </h5>
              <p class="text-muted mb-0" style="font-size: 0.9rem;">
                Placed on <%= order.created_at.strftime("%B %d, %Y") %>
              </p>
            </div>

            <div class="text-end">
              <% status = order.status.to_s.downcase %>
              <% badge_class =
                    case status
                    when "paid"      then "bg-success"
                    when "pending"   then "bg-warning text-dark"
                    when "cancelled" then "bg-danger"
                    else "bg-secondary"
                    end %>
              <span class="badge <%= badge_class %> px-3 py-2">
                <%= order.status.to_s.titleize %>
              </span>

              <p class="fw-semibold mb-0 mt-2">
                Total: <%= number_to_currency(order.total_cents / 100.0) %>
              </p>
            </div>
          </div>

          <hr>

          <!-- Items list inside the order -->
          <% if order.order_items.any? %>
            <p class="text-muted mb-2" style="font-size: 0.9rem;">
              Items in this order:
            </p>

            <% order.order_items.each do |item| %>
              <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                <div>
                  <div class="fw-semibold">
                    <%= item.corpse_flower.name %>
                  </div>
                  <div class="text-muted" style="font-size: 0.9rem;">
                    Qty: <%= item.quantity %> ·
                    Price: <%= number_to_currency(item.price_cents / 100.0) %>
                  </div>
                </div>

                <div>
                  <%= link_to "Join Scavenger Hunt",
                              new_hunt_registration_path(order_item_id: item.id),
                              class: "btn btn-sm btn-success" %>
                </div>
              </div>
            <% end %>
          <% else %>
            <p class="text-muted mb-3">
              No items recorded for this order.
            </p>
          <% end %>

          <!-- Footer: view order details -->
          <div class="mt-3 d-flex justify-content-between align-items-center">
            <%= link_to "View order details",
                        order_path(order),
                        class: "btn btn-outline-secondary btn-sm" %>

            <span class="text-muted" style="font-size: 0.85rem;">
              You can write reviews from the order details page.
            </span>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="card shadow-sm border-0">
      <div class="card-body text-center py-5">
        <h5 class="mb-2">You don’t have any orders yet.</h5>
        <p class="text-muted mb-3">
          Once you purchase a corpse flower, your orders will appear here.
        </p>
        <%= link_to "Browse flowers",
                    corpse_flowers_path,
                    class: "btn btn-primary" %>
      </div>
    </div>
  <% end %>
</div>