<h1>My Orders</h1>

<% if flash[:alert].present? %>
  <p style="color: red;"><%= flash[:alert] %></p>
<% end %>

<% if @orders.any? %>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Date</th>
        <th>Status</th>
        <th>Total</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @orders.each do |order| %>
        <tr>
          <td><%= order.id %></td>
          <td><%= order.created_at.strftime("%b %d, %Y") %></td>
          <td><%= order.status %></td>
          <td><%= number_to_currency(order.total_cents / 100.0) %></td>
          <td><%= link_to "View", order_path(order) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>You don’t have any orders yet.</p>
<% end %>
