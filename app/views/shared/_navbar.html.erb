<nav class="navbar navbar-expand-lg" style="background-color: #2d5f2e;">
  <div class="container-fluid">
    <!-- Brand -->
    <a class="navbar-brand text-white fw-bold" href="<%= root_path %>" style="font-size: 1.5rem;">
      Chartreuse
    </a>

    <!-- Toggler for mobile -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" style="border-color: rgba(255,255,255,0.3);">
      <span class="navbar-toggler-icon" style="filter: invert(1);"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <!-- CENTERED Search Box (US03) -->
      <div class="mx-auto" style="max-width: 400px; width: 100%;">
        <%= form_with url: corpse_flowers_path, method: :get, class: "d-flex", role: "search" do |form| %>
          <%= form.text_field :search, 
              value: params[:search], 
              class: "form-control", 
              placeholder: "Search flowers...",
              style: "border-radius: 4px;" %>
        <% end %>
      </div>

      <!-- RIGHT Navigation Links -->
      <ul class="navbar-nav ms-auto">
        <li class="nav-item">
          <%= link_to "Browse", corpse_flowers_path, class: "nav-link text-white #{'fw-bold' if current_page?(corpse_flowers_path)}" %>
        </li>
        <li class="nav-item">
          <a class="nav-link text-white" href="#">Hunt</a>
        </li>
        <li class="nav-item">
          <a class="nav-link text-white" href="#">Account</a>
        </li>
        <li class="nav-item">
          <a class="nav-link text-white" href="#">
            Cart (0)
          </a>
        </li>
      </ul>
    </div>
  </div>
</nav>

<style>
  /* Make search box submit on enter */
  .navbar form input[type="text"] {
    background-color: white;
  }
  
  .navbar form input[type="text"]:focus {
    border-color: #4CAF50;
    box-shadow: 0 0 0 0.2rem rgba(76, 175, 80, 0.25);
  }

  /* Navbar link hover effect */
  .navbar-nav .nav-link:hover {
    opacity: 0.8;
  }
</style>
